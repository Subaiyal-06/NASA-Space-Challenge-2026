{
  "name": "earth-jukebox",
  "version": "0.1.0",
  "description": "Earth Jukebox: Pakistan - hear the climate, month by month",
  "private": true,
  "type": "module",
  "author": "Earth Jukebox team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "check-data": "node tests/check-data.mjs",
    "test": "vitest run --passWithNoTests",
    "dist": "vite build && electron-builder --win nsis zip"
  },
  "build": {
    "appId": "org.earthjukebox.app",
    "productName": "Earth Jukebox",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^25.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.0"
  }
}
