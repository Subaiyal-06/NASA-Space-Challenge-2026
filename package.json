{
  "name": "earth-jukebox",
  "version": "0.1.0",
  "description": "Earth Jukebox: Pakistan - hear the climate, month by month",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "check-data": "node tests/check-data.mjs",
    "check-scale": "node tests/check-scale.mjs"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "maplibre-gl": "^6.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
